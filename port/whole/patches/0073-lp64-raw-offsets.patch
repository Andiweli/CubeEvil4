-#define CMES_FLAGS (*(u32*) ((u8*) &cMes + 0xFC))
-#define CMES_RESULT (*(s8*) ((u8*) &cMes + 0x1D1))
+/* port: patch 0073: message 1 through the accessors. 0xFC / 0x1D1 are m_Msg[1].m_state / .m_sel as
+ * MWCC lays the classes out (vptr behind the fields); the port's compilers put the vptr first,
+ * so the offsets hit be_flag / a byte of m_selTbl there, on 32 and on 64 bit */
+#define CMES_FLAGS (cMes.GetMesStatus(1))
+#define CMES_RESULT (cMes.GetSelectMessage(1))
 
