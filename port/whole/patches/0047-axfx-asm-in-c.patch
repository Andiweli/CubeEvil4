+/* 160 samples at a pitch below 1: per output at most one new sample; the
+ * 4-tap interpolation of rsmpTab12khz by the top 7 bits of the fraction */
+static void do_src1(AXFX_CHORUS_SRCINFO* src) {
+    u32 posLo = src->posLo;
+    u32 posHi = src->posHi;
+    u32 pitchLo = src->pitchLo;
+    u32 trigger = src->trigger;
+    u32 target = src->target;
+    s32* smp = src->smpBase;
+    s32* dest = src->dest;
+    s32* old = src->old;
+    f32 f1 = (f32)old[0];
+    f32 f2 = (f32)old[1];
+    f32 f3 = (f32)old[2];
+    f32 f4 = (f32)smp[posHi];
+    s32 i;
+
+    for (i = 0; i < 160; i++) {
+        const f32* c = &rsmpTab12khz[(posLo >> 25) * 4];
+        u32 next = posLo + pitchLo;
+        int carry = next < posLo;
+        f32 out = f1 * c[0] + f2 * c[1] + f3 * c[2] + f4 * c[3];
+
+        posLo = next;
+        if (carry) {
+            posHi++;
+            f1 = f2;
+            f2 = f3;
+            f3 = f4;
+            if (posHi == trigger) {
+                posHi = target;
+            }
+            if (i != 159) {
+                f4 = (f32)smp[posHi];
+            }
+        }
+        dest[i] = AXFXPortTrunc(out);
+    }
+    old[0] = AXFXPortTrunc(f1);
+    old[1] = AXFXPortTrunc(f2);
+    old[2] = AXFXPortTrunc(f3);
+    src->posLo = posLo;
+    src->posHi = posHi;
+}
+
+/* the same at a pitch between 1 and 2: one or two new samples per output */
+static void do_src2(AXFX_CHORUS_SRCINFO* src) {
+    u32 posLo = src->posLo;
+    u32 posHi = src->posHi;
+    u32 pitchLo = src->pitchLo;
