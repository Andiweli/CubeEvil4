+static s32 AXFXPortRound(f32 v) {
+    f32 r;
+    if (v >= 2147483647.0f) {
+        return 0x7FFFFFFF;
+    }
+    if (v <= -2147483648.0f) {
+        return (s32)0x80000000;
+    }
+    /* to nearest, ties to even (fctiw with the default rounding mode) */
+    r = (f32)(s32)v;
+    if (v - r > 0.5f || (v - r == 0.5f && ((s32)r & 1))) {
+        r += 1.0f;
+    } else if (r - v > 0.5f || (r - v == 0.5f && ((s32)r & 1))) {
+        r -= 1.0f;
+    }
+    return (s32)r;
+}
+
+static void AXFXPortWrite(AXFX_REVHI_DELAYLINE* dl, f32 v) {
+    dl->inputs[dl->inPoint >> 2] = v;
+    dl->inPoint += 4;
+    if (dl->inPoint == dl->length) {
+        dl->inPoint = 0;
+    }
+}
+
+static f32 AXFXPortRead(AXFX_REVHI_DELAYLINE* dl) {
+    f32 v = dl->inputs[dl->outPoint >> 2];
+    dl->outPoint += 4;
+    if (dl->outPoint == dl->length) {
+        dl->outPoint = 0;
+    }
+    return v;
+}
+
+/* not static: dolphin/axfx.h declares it */
+void DoCrossTalk(s32* l, s32* r, f32 cross, f32 invcross) {
+    s32 i;
+
+    for (i = 0; i < 160; i++) {
+        f32 fl = (f32)l[i];
+        f32 fr = (f32)r[i];
+        l[i] = AXFXPortRound(fl * invcross + fr * cross);
+        r[i] = AXFXPortRound(fl * cross + fr * invcross);
+    }
+}
+
+static void HandleReverb(s32* sptr, AXFX_REVHI_WORK* rv, s32 k) {
+    AXFX_REVHI_DELAYLINE* c = &rv->C[k * 3];
+    AXFX_REVHI_DELAYLINE* ap = &rv->AP[k * 3];
+    f32 g = rv->allPassCoeff;
+    f32 damping = rv->damping;
+    f32 wet = rv->level * 0.6f;
+    f32 dry = 0.6f - wet;
+    f32 cc0 = rv->combCoef[k * 3 + 0];
+    f32 cc1 = rv->combCoef[k * 3 + 1];
+    f32 cc2 = rv->combCoef[k * 3 + 2];
+    f32 lp = rv->lpLastout[k];
+    s32 i;
+
+    for (i = 0; i < 160; i++) {
+        f32 x = (f32)sptr[i];
+        f32 d = x;
+        f32 w0, w1, sum, w, y;
+
+        if (rv->preDelayTime != 0) {
+            /* The assembly stores the advanced pre-delay pointer into the line
+             * (at its byte 0x1B8) instead of rv->preDelayPtr[k], which so stays
+             * at the line's start: the pre-delay is one sample. Kept so it sounds
+             * the same; the stray store is left out. */
+            f32* p = rv->preDelayPtr[k];
+            d = p[0];
+            p[0] = x;
+        }
+        /* three combs */
+        w0 = cc0 * c[0].lastOutput + d;
+        w1 = cc1 * c[1].lastOutput + d;
+        AXFXPortWrite(&c[0], w0);
+        AXFXPortWrite(&c[1], w1);
+        c[0].lastOutput = AXFXPortRead(&c[0]);
+        c[1].lastOutput = AXFXPortRead(&c[1]);
+        sum = c[0].lastOutput + c[1].lastOutput;
+        w = cc2 * c[2].lastOutput + d;
+        AXFXPortWrite(&c[2], w);
+        c[2].lastOutput = AXFXPortRead(&c[2]);
+        sum = sum + c[2].lastOutput;
+        /* two all-passes */
+        w = g * ap[0].lastOutput + sum;
+        AXFXPortWrite(&ap[0], w);
+        y = ap[0].lastOutput - g * w;
+        ap[0].lastOutput = AXFXPortRead(&ap[0]);
+        w = g * ap[1].lastOutput + y;
+        AXFXPortWrite(&ap[1], w);
+        y = ap[1].lastOutput - g * w;
+        ap[1].lastOutput = AXFXPortRead(&ap[1]);
+        /* the low-pass, then the third all-pass */
+        lp = damping * lp + y * 0.3f;
+        w = g * ap[2].lastOutput + lp;
+        AXFXPortWrite(&ap[2], w);
+        y = ap[2].lastOutput - g * w;
+        ap[2].lastOutput = AXFXPortRead(&ap[2]);
+        sptr[i] = AXFXPortTrunc(wet * y + dry * x);
+    }
+    rv->lpLastout[k] = lp;
 }
 
