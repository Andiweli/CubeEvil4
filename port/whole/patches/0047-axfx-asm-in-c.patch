+/* port: patch 0047, C for the Gekko assembly of the SDK: the same steps in the
+ * same order, in single precision (fctiwz = truncation, fctiw = rounding). */
+static s32 AXFXPortTrunc(f32 v) {
+    if (v >= 2147483647.0f) {
+        return 0x7FFFFFFF;
+    }
+    if (v <= -2147483648.0f) {
+        return (s32)0x80000000;
+    }
+    return (s32)v;
+}
+
+static void AXFXPortWrite(AXFX_REVSTD_DELAYLINE* dl, f32 v) {
+    dl->inputs[dl->inPoint >> 2] = v;
+    dl->inPoint += 4;
+    if (dl->inPoint == dl->length) {
+        dl->inPoint = 0;
+    }
+}
+
+static f32 AXFXPortRead(AXFX_REVSTD_DELAYLINE* dl) {
+    f32 v = dl->inputs[dl->outPoint >> 2];
+    dl->outPoint += 4;
+    if (dl->outPoint == dl->length) {
+        dl->outPoint = 0;
+    }
+    return v;
+}
+
+/* left, right and surround one after the other (AXAux.c keeps them in one
+ * block, 160 samples each) */
+static void HandleReverb(s32* sptr, AXFX_REVSTD_WORK* rv) {
+    f32 g = rv->allPassCoeff;
+    f32 damping = rv->damping;
+    f32 wet = rv->level * 0.6f;
+    f32 dry = 0.6f - wet;
+    s32 k;
+    s32 i;
+
+    for (k = 0; k < 3; k++, sptr += 160) {
+        AXFX_REVSTD_DELAYLINE* c = &rv->C[k * 2];
+        AXFX_REVSTD_DELAYLINE* ap = &rv->AP[k * 2];
+        f32 cc0 = rv->combCoef[k * 2 + 0];
+        f32 cc1 = rv->combCoef[k * 2 + 1];
+        f32 lp = rv->lpLastout[k];
+        f32* line = rv->preDelayLine[k];
+        f32* p = rv->preDelayPtr[k];
+        f32* last = line + (rv->preDelayTime - 1);
+
+        for (i = 0; i < 160; i++) {
+            f32 x = (f32)sptr[i];
+            f32 d = x;
+            f32 w0, w1, sum, w, y;
+
+            if (rv->preDelayTime != 0) {
+                d = *p;
+                *p = x;
+                p++;
+                if (p == last) {
+                    p = line;
+                }
+            }
+            /* two combs */
+            w0 = cc0 * c[0].lastOutput + d;
+            w1 = cc1 * c[1].lastOutput + d;
+            AXFXPortWrite(&c[0], w0);
+            AXFXPortWrite(&c[1], w1);
+            c[0].lastOutput = AXFXPortRead(&c[0]);
+            c[1].lastOutput = AXFXPortRead(&c[1]);
+            sum = c[0].lastOutput + c[1].lastOutput;
+            /* an all-pass, the low-pass, the second all-pass */
+            w = g * ap[0].lastOutput + sum;
+            AXFXPortWrite(&ap[0], w);
+            y = ap[0].lastOutput - g * w;
+            ap[0].lastOutput = AXFXPortRead(&ap[0]);
+            lp = damping * lp + y * 0.3f;
+            w = g * ap[1].lastOutput + lp;
+            AXFXPortWrite(&ap[1], w);
+            y = ap[1].lastOutput - g * w;
+            ap[1].lastOutput = AXFXPortRead(&ap[1]);
+            sptr[i] = AXFXPortTrunc(wet * y + dry * x);
+        }
+        rv->lpLastout[k] = lp;
+        rv->preDelayPtr[k] = p;
+    }
 }
 
