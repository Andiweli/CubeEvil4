# CRI middleware (M9): platform parts of the CRI sources. The time base through
# re4_cri_timer (runtime/vi.cpp: OSGetTime, with RE4_VI_FAST the fields
# delivered, so the sound clock stays in step), no GQR save/restore (the decoder kernels are C, re4_cri_gqr),
# HID2 without the locked cache, no big-endian self-check (the byte-order
# dependent reads are patch 0051), the IDCT table addresses in C, sscanf as
# the C library declares it.
--- a/src/lib/uty_tmr.c
+++ b/src/lib/uty_tmr.c
@@ -9,18 +9,11 @@
 static Uint32 utytmr_work[6];
 
 /* time base read (upper, lower, upper again until stable) */
+/* port: the time base from runtime/vi.cpp (OSGetTime, with RE4_VI_FAST the fields delivered) */
+extern Sint64 re4_cri_timer(void);
 static Sint64 utytmr_read(void)
 {
-	register Uint32 hi, lo, hi2;
-	asm {
-	loop:
-		mftb hi, 269
-		mftb lo, 268
-		mftb hi2, 269
-		cmpw hi2, hi
-		bne loop
-	}
-	return ((Sint64)hi << 32) | lo;
+	return re4_cri_timer();
 }
 
