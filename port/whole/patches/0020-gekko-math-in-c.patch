+/* port: C version of the paired-single series of SINF/COSF. Lane 0 sums the odd, lane 1 the
+   even powers: f3 = powx, f4 = sum, f2 = (powx[0] * x, x * x); five times
+   f3 = f2 * f3.ps1 (ps_muls1), f4 = f3 * Coeff[2i..2i+1] + f4 (ps_madd, fused); the result is
+   lane 0 + lane 1 (ps_sum0). Every product and sum is rounded to single precision as on Gekko. */
+static f32 PsSeries(f32 x)
+{
+    f32 p0 = powx[0];
+    f32 p1 = powx[1];
+    f32 s0 = sum[0];
+    f32 s1 = sum[1];
+    f32 a0 = p0 * x;
+    f32 a1 = x * x;
+    int i;
