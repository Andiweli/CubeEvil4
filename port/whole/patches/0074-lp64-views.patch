# 64-bit build (milestone 12, way A): structures laid over another object with
# the GameCube offsets ("views": a byte pad up to the field they name). On LP64
# the object's base classes and works grow (pointers), so each view now reaches
# the field by name: RE4_OFS(T, member, gc) (re4_whole_prelude.h, checked
# against the GameCube offset on ILP32) or, for the own work behind a base
# class, RE4_OWN(Base, T, gc): on LP64 that work starts in the base's tail
# padding (behind cEm at 0x49C, sizeof(cEm) is 0x4A0). Found with
# port/tools/m12/cast_check.py (now also for C++ units and for views over a
# member, `(GxWork*) &pG->gxStage`) and a search for structures that start
# with a byte pad.
# - trans.cpp cPartsWk: cParts::pList and the bind matrix (skinning of every
#   model).
# - emwindow.h EmWindowWork: EmObjWork::eff (windows and fences, r100).
# - em3e.h EmMarkView, objTrolley.cpp TrolleyEmWork: the own work behind cEm
#   (FREE_EM10::Target_dir for the trolley).
# - TexRender.cpp: the event's frame, fast-forward frame, last frame and status
#   bits through the Event members instead of TexRenderEvt.
# - light_area.cpp LightAreaLauncher: cObjLauncher::pRocket.
# - r310.cpp, r30c.cpp: the player's word at +0x328 (cEm::dmg.m_PosFrom);
#   r316.cpp: cItemObj::fall_spd.y; r317.cpp: the object's own work behind
#   cObj; r300.cpp, r318.cpp: 8 bytes into the effect's work behind cEsp.
# - db_work.cpp DbObj18Work: FREE_OBJ18::obj18_type and NameMod (debug viewer).
# GxWork (trans.cpp, its prim pointer is pG->prim_base) and SaveDataPtrs
# (card.cpp, a view of SAVE_DATA_HEAD) keep the GameCube form instead
# (port/whole/fixed_form.json): on LP64 GxWork::prim overwrote pG->prim_cnt
# (black title, crash in primFree on the Retroid, 17.10.2026).
--- a/src/game/trans.cpp
+++ b/src/game/trans.cpp
@@ -61,7 +61,7 @@
 
 // Parts (cParts) fields past cCoord: the parts chain and the inverse bind matrix.
 struct cPartsWk {
-    u8 pad_0[0xF4];
+    u8 pad_0[RE4_OFS(cParts, pList, 0xF4)];  // port: patch 0074, cParts::pList (moves on LP64)
     cPartsWk* next;  // 0xF4
     Mtx bindMat;     // 0xF8
 };
--- a/include/emwindow.h
+++ b/include/emwindow.h
@@ -7,7 +7,7 @@
 
 // Work of the window / fence enemy (game/emwindow.cpp), overlaid on the EmObjWork from 0x3E0.
 struct EmWindowWork {
-    u8 pad_0[0x25C];
+    u8 pad_0[RE4_OFS(EmObjWork, eff, 0x25C)];  // port: patch 0074 (EmObjWork moves on LP64)
     u8 eff;               // 0x25C (0x63C)  EmObjWork::eff
     u8 pad_25D[3];
     void* arc;            // 0x260 (0x640)  room etc archive (GetEtcAddr source of the break model / fcv)
--- a/src/game/TexRender.cpp
+++ b/src/game/TexRender.cpp
@@ -353,7 +353,7 @@
 // Event flag test.
 static inline bool evtFlag(TexRenderEvt* e, u32 bit)
 {
-    return (e->flags & bit) != 0;
+    return (((Event*) e)->StatusFlag & bit) != 0;  // port: patch 0074, the Event's own members (they move on LP64)
 }
 
 // Before the render-to-texture passes: builds a CameraMotion at the event's frame (frameB with
@@ -362,13 +362,13 @@
 void CamRenderPrev(TexRenderEvtCamStruct* pWk)
 {
     TexRenderEvt* e = pWk->pEvt;
-    int frame = e->frame;
+    int frame = ((Event*) e)->GetNowFrame();  // port: patch 0074 (TexRenderEvt: frame)
 
     if (evtFlag(e, 0x40000000)) {
-        frame = e->frameB;
+        frame = ((Event*) e)->GetFFNowFrame();  // frameB
     }
     if (evtFlag(e, 0x08000000)) {
-        frame = e->frameEnd - 1;
+        frame = ((Event*) e)->GetMaxFrame() - 1;  // frameEnd
     }
     pWk->pProc = new (&pWk->cam) CameraMotion(pWk->pDat, 0, 0, (f32) frame);
     pWk->pProc->move();
