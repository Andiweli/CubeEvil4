+        RE4_PB_WORD(p, 0x08000000); p += 1;
+        RE4_PB_WORD(p, 0); p += 1;
     } else {
         u32 sampleStart;
         u32 sampleLoop;
@@ -142,20 +149,20 @@
         sampleEnd = sampleStart + voice->sample->length - 1;
         
         p = (u32*)&axvpb->pb.addr;
