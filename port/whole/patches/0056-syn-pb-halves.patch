# SDK SYN (the synthesizer of the game's sequenced sounds, snd_seq*.cpp): the
# voice set-up (synsample.c) and the pitch update (synpitch.c) wrote 32-bit
# values as one word over two u16 fields of the AX parameter block (sample
# addresses, loop flag and format, gain, sample rate ratio). On the
# little-endian host the halves were swapped: addresses far outside ARAM, the
# ratio's fraction as its integer part, so AX read its cycle table out of
# bounds (estimates over 3 billion) and stopped voices ("ISS Voice Drop").
# The values are now stored high half first, as the GameCube's word store did.
--- a/src/lib/synsample.c
+++ b/src/lib/synsample.c
@@ -4,6 +4,13 @@
 #include "fake_tgmath.h"
 
 #include "__syn.h"
+
+/* port: the parameter block keeps its 32-bit values (addresses, gain words) in
+ * two u16 fields, high half first (AXPBADDR, AXPBADPCM). The setups below wrote
+ * them as words: right on the big-endian GameCube, halves swapped on a
+ * little-endian host. RE4_PB_WORD stores them as the GameCube did. The word
+ * copies of the ADPCM coefficients copy memory as it is and stay. */
+#define RE4_PB_WORD(p, v) (((u16*)(p))[0] = (u16)((u32)(v) >> 16), ((u16*)(p))[1] = (u16)(u32)(v))
 
 // prototypes
 static u32 __SYNGetNibbleAddress(u32 count);
@@ -43,10 +50,10 @@
         // why not just write to the members directly?
         sampleStart = sampleStart + 2;
         p = (u32*)&axvpb->pb.addr;
-        *(p) = 0x10000; p += 1;
-        *(p) = sampleLoop; p += 1;
-        *(p) = sampleEnd; p += 1;
-        *(p) = sampleStart; p += 1;
+        RE4_PB_WORD(p, 0x10000); p += 1;
+        RE4_PB_WORD(p, sampleLoop); p += 1;
+        RE4_PB_WORD(p, sampleEnd); p += 1;
+        RE4_PB_WORD(p, sampleStart); p += 1;
         *(p) = *(adpcm); p += 1, adpcm += 1;
         *(p) = *(adpcm); p += 1, adpcm += 1;
         *(p) = *(adpcm); p += 1, adpcm += 1;
@@ -82,10 +89,10 @@
         // same wtf writes here
         sampleStart = sampleStart + 2;
         p = (void*)&axvpb->pb.addr;
-        *(p) = 0; p += 1;
-        *(p) = sampleLoop; p += 1;
-        *(p) = sampleEnd; p += 1;
-        *(p) = sampleStart; p += 1;
+        RE4_PB_WORD(p, 0); p += 1;
+        RE4_PB_WORD(p, sampleLoop); p += 1;
+        RE4_PB_WORD(p, sampleEnd); p += 1;
+        RE4_PB_WORD(p, sampleStart); p += 1;
         *(p) = *(adpcm); p += 1, adpcm += 1;
         *(p) = *(adpcm); p += 1, adpcm += 1;
         *(p) = *(adpcm); p += 1, adpcm += 1;
@@ -116,20 +123,20 @@
         sampleEnd = sampleLoop + voice->region->loopLength - 1;
 
         p = (u32*)&axvpb->pb.addr;
-        *(p) = 0x1000A; p += 1;
-        *(p) = sampleLoop; p += 1;
-        *(p) = sampleEnd; p += 1;
-        *(p) = sampleStart; p += 1;
-        *(p) = 0; p += 1;
-        *(p) = 0; p += 1;
-        *(p) = 0; p += 1;
-        *(p) = 0; p += 1;
-        *(p) = 0; p += 1;
-        *(p) = 0; p += 1;
-        *(p) = 0; p += 1;
-        *(p) = 0; p += 1;
-        *(p) = 0x08000000; p += 1;
-        *(p) = 0; p += 1;
+        RE4_PB_WORD(p, 0x1000A); p += 1;
+        RE4_PB_WORD(p, sampleLoop); p += 1;
+        RE4_PB_WORD(p, sampleEnd); p += 1;
+        RE4_PB_WORD(p, sampleStart); p += 1;
+        RE4_PB_WORD(p, 0); p += 1;
+        RE4_PB_WORD(p, 0); p += 1;
+        RE4_PB_WORD(p, 0); p += 1;
+        RE4_PB_WORD(p, 0); p += 1;
+        RE4_PB_WORD(p, 0); p += 1;
+        RE4_PB_WORD(p, 0); p += 1;
+        RE4_PB_WORD(p, 0); p += 1;
