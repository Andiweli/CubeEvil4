+/* port: GQR6, the quantisation register of the skinning loops (setupGQR6). */
+static u32 sGqr6;
+
+/* port: C version of the paired-single skinning loops below. Per vertex: the palette matrix
+   (ROMtx, 12 floats, in the locked cache at index * 0x30) times the dequantised input
+   (x, y, z) * 2^-load scale, three fused multiply-adds per row starting from the
+   translation (ps_madds0/ps_madds1/ps_madds0), then quantised: times 2^store scale, clamped,
+   truncated. The scales come from GQR6. The hardware loop runs 2^32 times for n == 0 and
+   reads the matrix index of the vertex after the last; neither is reproduced. */
+static void Sk1Loop(void* dst, const void* src, u32 n, int bytes)
+{
+    u32 gqr = sGqr6;
+    f32 ld = ldexpf(1.0f, -re4_gqr_scale(gqr >> 24));
+    f32 st = ldexpf(1.0f, re4_gqr_scale(gqr >> 8));
+    u32 type = bytes ? 6 : 7;
+    u32 i;
+
+    if (((gqr >> 16) & 7) != type || (gqr & 7) != type) {
+        static int reported;
+        if (!reported) {
+            reported = 1;
+            re4_log("CalcSk1: GQR6 %08lx does not match the vertex type", (unsigned long) gqr);
+        }
+    }
+    for (i = 0; i < n; i++) {
+        f32 v[3];
+        f32 r[3];
+        u32 idx;
+        int k;
+        const f32* m;
+
+        if (bytes) {
+            const s8* in = (const s8*) src + i * 4;
+            v[0] = (f32) in[0] * ld;
+            v[1] = (f32) in[1] * ld;
+            v[2] = (f32) in[2] * ld;
+            idx = (u8) in[3];
+        } else {
+            const s16* in = (const s16*) src + i * 4;
+            v[0] = (f32) in[0] * ld;
+            v[1] = (f32) in[1] * ld;
+            v[2] = (f32) in[2] * ld;
+            idx = (u32) (s32) in[3];
+        }
+        if (idx >= RE4_LOCKED_CACHE_SIZE / 0x30) {
+            static int bad;
+            if (!bad) {
+                bad = 1;
+                re4_log("CalcSk1: matrix index %ld outside the locked cache", (long) (s32) idx);
+            }
+            continue;
+        }
+        m = (const f32*) (RE4_LC_BASE + idx * 0x30);
+        for (k = 0; k < 3; k++) {
+            r[k] = fmaf(m[6 + k], v[2], fmaf(m[3 + k], v[1], fmaf(m[k], v[0], m[9 + k])));
+        }
+        if (bytes) {
+            s8* out = (s8*) dst + i * 3;
+            for (k = 0; k < 3; k++) {
+                out[k] = (s8) re4_quantize(r[k] * st, -128.0f, 127.0f);
+            }
+        } else {
+            s16* out = (s16*) dst + i * 3;
+            for (k = 0; k < 3; k++) {
+                out[k] = (s16) re4_quantize(r[k] * st, -32768.0f, 32767.0f);
+            }
+        }
+    }
+}
