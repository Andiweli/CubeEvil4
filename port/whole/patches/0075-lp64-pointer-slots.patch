# 64-bit build (milestone 12, way A): pointers kept in 4-byte places. On LP64 a
# pointer has 8 bytes, so a function that stores one into a 4-byte variable
# overwrites its neighbour, and tables of 4-byte entries read or written as
# pointers mix up their entries. Found with port/tools/m12/ptr_slot_check.py
# (casts of a 4-byte object's address to a pointer to a pointer).
# - event.cpp: EventMgr::GetRead stored the unit into `int d` (stack
#   corruption in EvtReadSub when r120's car ride event loads, Retroid
#   17.10.2026); Event::PFuncTbl (u32) got the function table the same way
#   and overwrote the next member. Both now through a pointer variable.
# - ss_pzzl.cpp, ss_shop.cpp: the bin/tpl pair of ITEM_PIECE_INFO::model
#   (puzzle pieces, the merchant's item models) are two 4-byte words: written
#   and read as u32 (the writer stepped 30 pointers per 0x78-byte entry).
# - eprintf.cpp: the debug text pointers live in a MESS_PTR_NUM * 4 buffer
#   that is cleared and scanned in words: 4-byte slots (RE4_P32).
# - r332.cpp: R332_ARR_SET / R332_TASK_SET took GameCube byte offsets into
#   pointer arrays: now the index (offset / 4).
# - r20d.cpp: the lantern throw read mot[1] at the GameCube offset 0x18.
# Checked and left: mwsfdcre.c (SFD_GetTrHn into MWPLY x48 fills the padding in
# front of the 8-byte aligned lsc), r100.cpp / r103.cpp / t_esp.cpp (pointer
# members reached through RE4_OFS).
--- a/src/game/event.cpp
+++ b/src/game/event.cpp
@@ -190,7 +190,12 @@
         SndId[j] = 0;
         NowStr[j] = -1;
     }
-    EvtMgr.GetFunc((void**) &PFuncTbl, nm);
+    {
+        // port: patch 0075, the table address through a pointer (PFuncTbl has 4 bytes, a pointer 8 on LP64)
+        void* tbl;
+        EvtMgr.GetFunc(&tbl, nm);
+        PFuncTbl = (u32) (unsigned long) tbl;
+    }
     strcpy(Name, nm);
     if (CalMaxTotalFrame(&MaxCut, &MaxTotalFrame) != 0 && CalMaxFrame(&MaxFrame, NowCut) != 0) {
         return 1;
@@ -2838,16 +2843,17 @@
 {
     u8 type;
     int d;
+    void* dat;  // port: patch 0075, the unit through a pointer (`d` has 4 bytes, a pointer 8 on LP64)
 
     if (pDat == 0 || pWkNo == 0) {
         return 0;
     }
     *pDat = 0;
     *pWkNo = 0;
-    if (ReadTbl.GetDat((void**) &d, &type, pName, 0) == 0) {
-        return 0;
-    }
-    *pDat = (void*) d;
+    if (ReadTbl.GetDat(&dat, &type, pName, 0) == 0) {
+        return 0;
+    }
+    *pDat = dat;
