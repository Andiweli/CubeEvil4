+/* port: patch 0036. These tables were bit-field structs that GXSetTevOp reads
+ * as whole words (*(u32*)): MWCC on the big-endian Gekko allocates bit-fields
+ * from the most significant bit, compilers for little-endian targets from the
+ * least, so the words came out scrambled (the TEV stages of GXSetTevOp were
+ * garbage). The words are built field by field as the GameCube holds them;
+ * the fields and values are the original ones. */
+#define RE4_TEVC_WORD(rid, dest, shift, clamp, sub, bias, a, b, c, d)                              \
+    ((u32) (rid) << 24 | (u32) (dest) << 22 | (u32) (shift) << 20 | (u32) (clamp) << 19 |           \
+     (u32) (sub) << 18 | (u32) (bias) << 16 | (u32) (a) << 12 | (u32) (b) << 8 | (u32) (c) << 4 |     \
+     (u32) (d))
+#define RE4_TEVA_WORD(rid, dest, shift, clamp, sub, bias, a, b, c, d, swap, mode)                  \
+    ((u32) (rid) << 24 | (u32) (dest) << 22 | (u32) (shift) << 20 | (u32) (clamp) << 19 |           \
+     (u32) (sub) << 18 | (u32) (bias) << 16 | (u32) (a) << 13 | (u32) (b) << 10 | (u32) (c) << 7 |    \
+     (u32) (d) << 4 | (u32) (swap) << 2 | (u32) (mode))
+
+static u32 TEVCOpTableST0[5] = {
+    RE4_TEVC_WORD(192, 0, 0, 1, 0, 0, 15, 8, 10, 15),   // modulate
+    RE4_TEVC_WORD(192, 0, 0, 1, 0, 0, 10, 8, 9, 15),    // decal
+    RE4_TEVC_WORD(192, 0, 0, 1, 0, 0, 10, 12, 8, 15),   // blend
+    RE4_TEVC_WORD(192, 0, 0, 1, 0, 0, 15, 15, 15, 8),   // replace
+    RE4_TEVC_WORD(192, 0, 0, 1, 0, 0, 15, 15, 15, 10),  // passclr
 };
 
