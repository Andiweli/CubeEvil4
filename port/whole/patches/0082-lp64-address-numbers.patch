# 64 bit (M12): GameCube byte offsets added to an address kept as a number
# (`(u32) em + 0x320`) or in a sum with an index (`i * sizeof(T) + (u32) w + 0x2C`),
# which raw_offset_check.py saw only since it follows integer views of a structure
# pointer and the constant terms of whole sums, and sizeof_ptr_check.py (18.10.2026).
# Each offset is now RE4_OFS(T, member, gc) (on ILP32 checked against the GameCube
# value at compile time); index and stride stay as they were.
# - sce_sys.cpp: the scene condition "this enemy is dead" read cEm::hp at 0x320;
#   on LP64 hp lies at 0x3B8 and the test read other bytes of the enemy.
# - sce_at.cpp: the corner logic of the camera stores SceAtSysWork::pCamAt with a
#   non-struct store at 0x120 (RAW_U32, kept for the GameCube's instruction order);
#   on LP64 pCamAt lies at 0x1B0 and is 8 bytes: the store hit another member and
#   pCamAt kept its old value. RAW_CAM_AT stores a pointer-wide value at the
#   member's offset (on ILP32 the same u32 store at 0x120).
# - r20e.cpp (the sliding puzzle): PUZZLE_PIECE (pieces at 0x10, LP64 0x18) and
#   PUZZLE_CELL / the cursor frame (cells at 0x178, LP64 0x1C8): on LP64 the
#   puzzle read and moved the wrong bytes.
# - r20d.cpp: the raise state of a fence (fence[i].t at 0x2C, LP64 0x40).
# - r21d.cpp: the traps (trap[] at 0x30C, LP64 0x380).
--- a/src/game/sce_at.cpp
+++ b/src/game/sce_at.cpp
@@ -125,6 +125,9 @@
 // the original's `lwz pPL` stays behind the store).
 #define RAW_F32(p, ofs) (*(f32*) ((u32) (p) + (ofs)))
 #define RAW_U32(p, ofs) (*(u32*) ((u32) (p) + (ofs)))
+// port: patch 0082, the pointer pCamAt through the same non-struct store, at its own offset and with
+// its own width (on LP64 at 0x1B0, 8 bytes; on ILP32 the GameCube store of a u32 at 0x120)
+#define RAW_CAM_AT(p) (*(__UINTPTR_TYPE__*) ((u32) (p) + RE4_OFS(SceAtSysWork, pCamAt, 0x120)))
 
 #define EM_DEAD_BIT(n, i) (*(u32*) (((i) << 2) + emDeadRow(n)))
 #define SAVE_ITEM_HALF(i, f) (*(u16*) (saveItemBase(PG_OFS(item_save[0].f)) + ((i) << 4)))
@@ -2772,7 +2775,7 @@
         found = c;
     }
     if (found != 0) {
-        RAW_U32(pS, 0x120) = (u32) found;
+        RAW_CAM_AT(pS) = (__UINTPTR_TYPE__) found;  // port: patch 0082
         CamCtrl.m_QuasiFPS.LRinfo(found);
         return;
     }
@@ -2782,7 +2785,7 @@
     }
     if (ret > 1) {
         if (ret == 2) {
-            RAW_U32(pS, 0x120) = (u32) &auto_work;
+            RAW_CAM_AT(pS) = (__UINTPTR_TYPE__) &auto_work;  // port: patch 0082
             auto_work.pos = pPL->pos;
             auto_work.ang_y = pPL->ang.y;
             CamCtrl.m_QuasiFPS.LRinfo(&auto_work);
@@ -2792,11 +2795,11 @@
             f32 lim = 250000.0f;
 
             if (lim < PSVECSquareDistance(&pPL->pos, &pS->pCamAt->pos)) {
-                RAW_U32(pS, 0x120) = 0;
+                RAW_CAM_AT(pS) = 0;  // port: patch 0082
             } else {
