# getNearPoint (route_ck.cpp, the enemies' route finding) sorts the ten route points nearest to a
# position into idx[]/dist[], which start as stack garbage and 1e16. A point farther than 1e8
# (squared distance above 1e16) never enters, so when fewer than ten (or nPoint) points lie within
# 1e8, the entries behind them keep their garbage and the clear-line search reads pt[garbage]:
# a tester's report (Samsung Galaxy M23, 64 bit, 0.41.0-alpha, the cabin siege r11c, twice about
# a minute after loading): signal 11 at an address far above 4 GB in getNearPoint, from
# RouteCkToEm / em10RouteCk (a Ganado finding its way to the partner). Only the filled entries
# are searched now; with none, -1, which every caller takes as "no route point" (the enemy goes
# straight for the target). A position inside a room fills them all, so nothing changes there.
# Whose position it was (player, partner or which enemy) is reported a few times ("check:
# route: ..."): such a position is itself a fault, which the report should show.
--- a/src/game/route_ck.cpp
+++ b/src/game/route_ck.cpp
@@ -560,6 +560,43 @@
     return getNearPoint(&pEm->pos, mode, flag);
 }
 
+/* PORT (patch 0088): whose position `pPos` is, for the log -- the player, the partner or an
+   enemy (the callers pass &em->pos through getNearInfo) -- reported a few times per run. */
+static void rckReportFar(Vec* pPos, int filled, int n)
+{
+    static int reported;
+    const char* who = "a position";
+    int id = -1;
+    int type = -1;
+    u32 i;
+
+    if (reported >= 4) {
+        return;
+    }
+    reported++;
+    if (pPL != NULL && pPos == &pPL->pos) {
+        who = "the player";
+    } else if (pSUB != NULL && pPos == &pSUB->pos) {
+        who = "the partner";
+        id = pSUB->id;
+        type = pSUB->type;
+    } else {
+        for (i = 0; i < EmMgr.getArrayNum(); i++) {
+            cEm* em = EmMgr.fastAt(i);
+            if (pPos == &em->pos) {
+                who = "an enemy";
+                id = em->id;
+                type = em->type;
+                break;
+            }
+        }
+    }
+    re4_log("check: route: %s (id 0x%x, type %d) at (%g %g %g): %d of the %d route points of room "
+            "r%x%02x lie within 1e8 of it, the others are not searched (patch 0088)",
+            who, id, type, (double) pPos->x, (double) pPos->y, (double) pPos->z, filled, n,
+            (unsigned) pG->stage_no, (unsigned) pG->room_no);
+}
+
 // Nearest route point to `pos`: the ten closest are sorted; mode != 0 returns the closest, else
 // the first with a clear line from 500 above pos. -1 when none.
 s8 getNearPoint(Vec* pPos, int mode, int flag)
@@ -576,6 +613,7 @@
     int j;
     int k;
     f32 d;
+    int filled;  /* PORT: the sorted entries that hold a point (patch 0088) */
 
     rtp = rtpData();
     if (rtp == NULL) {
@@ -593,6 +631,7 @@
         dist[i] = 1.0e16f;
     }
     pt = rtpPoint(rtpData());
+    filled = 0;
     for (i = 0; i < n; i++) {
         d = (pPos->x - pt->pos.x) * (pPos->x - pt->pos.x) + (pPos->y - pt->pos.y) * (pPos->y - pt->pos.y) +
             (pPos->z - pt->pos.z) * (pPos->z - pt->pos.z);
@@ -608,9 +647,25 @@
             }
             idx[j] = i;
             dist[j] = d;
+            if (filled < m) {
+                filled++;
+            }
         }
         pt++;
     }
+    /* PORT (patch 0088): a point farther than 1e8 (d > 1e16, the start value) never enters the
+       list, so with fewer than m such points the entries behind them keep idx[]'s stack garbage,
+       and the search below reads pt[garbage] (64-bit tester, Samsung Galaxy M23, cabin r11c:
+       fault far above 4 GB in getNearPoint from RouteCkToEm). Only the filled entries are
+       searched; none: -1, which every caller takes as "no route point". Positions inside a
+       room fill all of them, so nothing changes there. */
+    if (filled < m) {
+        rckReportFar(pPos, filled, n);
+        m = filled;
+        if (m == 0) {
+            return -1;
+        }
+    }
     if (mode != 0) {
         return idx[0];
     }
