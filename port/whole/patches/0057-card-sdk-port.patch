# SDK CARD (M10): what the memory card library needs to build and run on the
# port. CARDBios.c: the one- and two-byte card commands (0x81 interrupt
# enable, 0x83 read status, 0x85 vendor ID, 0x89 clear status, 0x87 / 0x88 wake
# / sleep) are built as a u32 and their first one or two bytes in memory are
# sent; on the little-endian host those were the low bytes (00 00).
# re4_card_cmd (re4_card_port.h) stores the word with the command byte first;
# the vendor ID the card sends high byte first is read back as such.
# CARDRdwr.c: CodeWarrior's cast as lvalue ((u8*) p += n) as a plain
# assignment. __os.h: the CodeWarrior section asm declarations only for
# CodeWarrior.
--- a/src/lib/CARDBios.c
+++ b/src/lib/CARDBios.c
@@ -152,7 +152,7 @@
         return CARD_RESULT_NOCARD;
     }
 
-    cmd = enable ? 0x81010000 : 0x81000000;
+    cmd = re4_card_cmd(enable ? 0x81010000 : 0x81000000); /* port: command bytes first in memory */
     err = FALSE;
     err |= !EXIImm(chan, &cmd, 2, EXI_WRITE, NULL);
     err |= !EXISync(chan);
@@ -170,7 +170,7 @@
         return CARD_RESULT_NOCARD;
     }
 
-    cmd = 0x83000000;
+    cmd = re4_card_cmd(0x83000000); /* port: command bytes first in memory */
     err = FALSE;
     err |= !EXIImm(chan, &cmd, 2, EXI_WRITE, NULL);
     err |= !EXISync(chan);
@@ -189,13 +189,14 @@
     if (!EXISelect(chan, 0, CARDFreq)) {
         return CARD_RESULT_NOCARD;
     }
-    cmd = 0x85000000;
+    cmd = re4_card_cmd(0x85000000); /* port: command bytes first in memory */
     err = 0;
     err |= !EXIImm(chan, &cmd, 2, EXI_WRITE, 0);
     err |= !EXISync(chan);
     err |= !EXIImm(chan, id, 2, EXI_READ, 0);
     err |= !EXISync(chan);
     err |= !EXIDeselect(chan);
+    *id = re4_card_be16(*id); /* port: the card sends the high byte first */
     return err ? CARD_RESULT_NOCARD : CARD_RESULT_READY;
 }
 
@@ -209,7 +210,7 @@
         return CARD_RESULT_NOCARD;
     }
 
-    cmd = 0x89000000;
+    cmd = re4_card_cmd(0x89000000); /* port: command bytes first in memory */
     err = FALSE;
     err |= !EXIImm(chan, &cmd, 1, EXI_WRITE, 0);
     err |= !EXISync(chan);
@@ -227,7 +228,7 @@
