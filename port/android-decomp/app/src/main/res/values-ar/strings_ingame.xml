<?xml version="1.0" encoding="utf-8"?>
<!-- Arabic (العربية): the texts of values/strings_ingame.xml, same names and placeholders.
     Written right to left: a text that begins with Latin letters or a file name starts with the
     right-to-left mark &#x200F; (else Android lays the whole line out left to right); the
     left-to-right mark &#x200E; keeps "1280 × 672" and ".gci" in their order. The FPS display
     stays left to right (CoreActivity). tools/check_translations.py checks all three. -->
