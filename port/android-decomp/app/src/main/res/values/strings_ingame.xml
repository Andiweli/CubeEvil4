<?xml version="1.0" encoding="utf-8"?>
<!--
  The app's menu in the game (CoreMenu, SELECT) and the app's messages around it (CoreActivity),
  in English: the text of every language the phone may use that has no file of its own
  (values-<language>/strings_ingame.xml with the same names; decision of the project owner,
  21.10.2026). Android picks the phone's language itself. Placeholders (%1$s, %1$d, …) and
  "\n" stay as they are in each translation; tools/check_translations.py compares them.
  The game's own texts (GameCube) and the error report stay as they are.
-->
